pipeline {
    agent any

    tools {
        jdk 'JDK17'
        maven 'Maven2'
    }

    options {
        skipDefaultCheckout(true)
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '15'))
    }

    environment {
        PROJECT_DIR = "${WORKSPACE}/expense-tracker"
        JAR_NAME = 'tracker-0.0.1-SNAPSHOT.jar'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build & Test with jacoco') {
            steps {
                dir("${PROJECT_DIR}") {
                    script {
                        if (isUnix()) {
                            sh 'java -version'
                            sh 'mvn -version'
                            sh 'mvn clean verify -B --no-transfer-progress'
                        } else {
                            bat 'java -version'
                            bat 'mvn -version'
                            bat 'mvn clean verify -B --no-transfer-progress'
                        }
                    }
                }
            }
        }

        stage('SonarQube analysis') {
            steps {
                dir("${PROJECT_DIR}") {
                    script {
                        // Jenkins: Manage Jenkins → Configure System → SonarQube servers → name must match below
                        withSonarQubeEnv('SonarQube') {
                            if (isUnix()) {
                                sh 'mvn -B --no-transfer-progress sonar:sonar'
                            } else {
                                bat 'mvn -B --no-transfer-progress sonar:sonar'
                            }
                        }
                    }
                }
            }
        }
        stage('SonarQube quality gate') {
            steps {
                // Requires SonarQube webhook → https://<jenkins>/sonarqube-webhook/
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Deploy') {
            steps {
                dir("${PROJECT_DIR}/target") {
                    script {
                        if (isUnix()) {
                            sh '''
                                pkill -f "${JAR_NAME}" || true
                                nohup java -jar "${JAR_NAME}" > app.log 2>&1 &
                            '''
                        } else {
                            bat "start /B java -jar %JAR_NAME% > app.log 2>&1"
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            archiveArtifacts artifacts: 'expense-tracker/target/*.jar',
                fingerprint: true,
                onlyIfSuccessful: true
        }
    }
}
