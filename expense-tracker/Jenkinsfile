pipeline {
    agent any

    tools {
        jdk 'JDK17'
        maven 'Maven2'
    }

    options {
        skipDefaultCheckout(true)
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '15'))
    }

    environment {
        PROJECT_DIR = "${WORKSPACE}/expense-tracker"
        JAR_NAME = 'tracker-0.0.1-SNAPSHOT.jar'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                dir("${PROJECT_DIR}") {
                    script {
                        if (isUnix()) {
                            sh 'java -version'
                            sh 'mvn -version'
                            sh 'mvn clean package -DskipTests -B --no-transfer-progress'
                        } else {
                            bat 'java -version'
                            bat 'mvn -version'
                            bat 'mvn clean package -DskipTests -B --no-transfer-progress'
                        }
                    }
                }
            }
        }

        stage('Deploy') {
            steps {
                dir("${PROJECT_DIR}/target") {
                    script {
                        if (isUnix()) {
                            sh '''
                                pkill -f "${JAR_NAME}" || true
                                nohup java -jar "${JAR_NAME}" > app.log 2>&1 &
                            '''
                        } else {
                            bat "start /B java -jar %JAR_NAME% > app.log 2>&1"
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            archiveArtifacts artifacts: 'expense-tracker/target/*.jar',
                fingerprint: true,
                onlyIfSuccessful: true
        }
    }
}
